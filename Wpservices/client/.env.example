DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wpservices?schema=public"

# Used to hash IP addresses before storage. Generate a long random value.
LEAD_HASH_SALT="replace-with-a-random-secret"

# Optional SMTP for Get a Free Quote emails. Recipient is always Info@technologiallc.com.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional Resend alternative. Recipient is always Info@technologiallc.com.
RESEND_API_KEY=""
RESEND_FROM=""
